# Configuration SmartShop WhatsApp — copier en .env et adapter.
# En production, TOUS les secrets doivent être définis (ne jamais utiliser les valeurs de dev).

SMARTSHOP_ENV=development
SMARTSHOP_DEBUG=true

# Secret de signature des sessions/jetons (OBLIGATOIRE en prod, long et aléatoire).
SMARTSHOP_SECRET_KEY=change-me-with-a-long-random-string

# Base de données. SQLite par défaut ; PostgreSQL obligatoire en production :
# le disque d'un conteneur est réinitialisé à chaque déploiement, un fichier
# SQLite y perd donc toutes les données (comptes, boutiques, produits).
# Exemple Postgres : postgresql://user:pass@localhost:5432/smartshop
# Sur Railway, référencer la base : ${{Postgres.DATABASE_URL}}
# À défaut, DATABASE_URL est lue automatiquement.
SMARTSHOP_DATABASE_URL=sqlite:///./smartshop.db

# Secret partagé avec l'agrégateur de paiement pour signer les webhooks.
SMARTSHOP_PAYMENT_WEBHOOK_SECRET=change-me-payment-secret

# URL publique utilisée pour les liens de boutique et QR codes.
SMARTSHOP_PUBLIC_BASE_URL=http://localhost:8000

# Cookies sécurisés (True uniquement derrière HTTPS).
SMARTSHOP_COOKIE_SECURE=false

# Durée de session en secondes (défaut 7 jours).
SMARTSHOP_SESSION_MAX_AGE=604800

# --- Création du super-administrateur --------------------------------------- #
# POST /api/setup/create-superadmin?token=<SMARTSHOP_SETUP_TOKEN> crée le compte
# défini ci-dessous. L'endpoint répond 404 tant que le jeton est vide ; le
# supprimer après usage pour le refermer.
SMARTSHOP_SETUP_TOKEN=
SMARTSHOP_ADMIN_EMAIL=
SMARTSHOP_ADMIN_PASSWORD=

# --- Passerelle de paiement Campay ------------------------------------------ #
# sandbox -> demo.campay.net (identifiants de démo, aucun argent réel)
# production -> www.campay.net (identifiants de production, paiements réels)
# Les deux jeux d'identifiants ne sont PAS interchangeables.
# Sans CAMPAY_API_USER/PASSWORD, les paiements sont simulés.
CAMPAY_MODE=sandbox
CAMPAY_APP_ID=
CAMPAY_API_USER=
CAMPAY_API_PASSWORD=
CAMPAY_WEBHOOK_KEY=
